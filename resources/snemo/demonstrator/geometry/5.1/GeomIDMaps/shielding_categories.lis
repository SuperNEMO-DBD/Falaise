#@description A sample list of geometry ID categories/types for tracker submodules
#@key_label   "category"
#@meta_label  "type"

[category="coil_wall_support" type="321"]
  inherits : string = "coil_wall"
  
[category="coil_wall_wire_block" type="322"]
  inherits : string = "coil_wall"

[category="coil_wire_set" type="323"]
  extends : string    = "coil_wall_wire_block"
  by      : string[1] = "wire"

[category="coil_wire" type="324"]
  inherits : string = "coil_wire_set"

[category="coil_wire_space" type="325"]
  inherits : string = "coil_wire_set"

