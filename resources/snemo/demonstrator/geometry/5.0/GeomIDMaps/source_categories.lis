# -*- mode: conf-unix; -*-
#@description A sample list of geometry ID categories/types for source submodule
#@key_label   "category"
#@meta_label  "type"

[category="source_submodule" type="1100"]
  inherits : string  = "module"
  # GID = [1100:0]

[category="source_core_volume" type="1114"]
  inherits : string  = "source_submodule"
  # GID = [1114:0]

[category="source_strip_block_assembly" type="1115"]
  inherits : string  = "source_core_volume"
  # To generate GIDs like [1115:0], [1115:1], [1115:2]...

[category="source_strip_path" type="1101"]
  extends : string    = "source_strip_block_assembly"
  by      : string[1] = "strip"
  # To generate GIDs like [1101:0.0], [1101:0.1] ... [1101:0.35]

[category="source_strip_gap" type="1113"]
  extends : string    = "source_strip_block_assembly"
  by      : string[1] = "gap"

[category="source_strip" type="1102"]
  inherits : string = "source_strip_path"

[category="source_strip_film" type="1120"]
  extends : string    = "source_strip"
  by      : string[1] = "film" 

[category="source_pad" type="1130"]
  extends : string    = "source_strip"
  by      : string[1] = "pad"

[category="source_pad_bulk" type="1131"]
  inherits : string = "source_pad"

[category="source_pad_film" type="1132"]
  extends : string    = "source_pad"
  by      : string[1] = "film"

[category="source_calibration_track" type="1103"]
  extends : string    = "source_strip_block_assembly"
  by      : string[1] = "track"
  # To generate GIDs like [1103:0.0], [1103:0.1] ... [1103:0.5]

[category="source_calibration_carrier" type="1110"]
  extends : string    = "source_calibration_track"
  by      : string[1] = "position"
  # To generate GIDs like [1103:0.0.0]... [1103:0.0.5] ... [1103:0.5.5]

[category="source_calibration_spot" type="1112"]
  inherits : string   = "source_calibration_carrier"
  # To generate GIDs like [1112:0.0.0]...

# end
