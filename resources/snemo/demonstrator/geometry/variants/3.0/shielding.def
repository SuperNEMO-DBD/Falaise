
[name="shielding.layout.PM" type="parameter"]
  #@config A parameter model describing the shielding layout
  display_name        : string = "Shielding layout"
  terse_description   : string = "The geometry layout of the shielding "
  mutability : string = "variable"
    variable.mode : string = "enumeration"
  type : string = "string"	
  string.default : string = "BasicIron"
  string.enumerated.size : integer = 3
     string.enumerated_0.value   : string = "BasicIron"
     string.enumerated_0.variant : string = "if_basic_iron"
     string.enumerated_1.value   : string = "Realistic1"
     string.enumerated_1.variant : string = "if_realistic_1"
     string.enumerated_2.value   : string = "None"
     string.enumerated_2.variant : string = "if_noshielding"
  variants : string[3] = "if_basic_iron" "if_realistic_1" "if_noshielding" 
    variants.if_basic_iron.model        : string = "datatools::basic::is_on.VM"
    variants.if_basic_iron.description  : string = "Set of parameters for basic iron shielding layout"
    variants.if_realistic_1.model       : string = "datatools::basic::is_on.VM"
    variants.if_realistic_1.description : string = "Set of parameters for realistic shielding layout #1"
    variants.if_noshielding.model       : string = "datatools::basic::is_off.VM"
    variants.if_noshielding.description : string = "No shielding"


[name="shielding.VM" type="variant"]
  #@config A variant model describing the parameters for the shielding
  display_name       : string = "Shielding layout"
  terse_description  : string = "The configuration parameters for the shielding layout"
  parameters : string[1] = "layout"
    parameters.layout.model       : string = "shielding.layout.PM"
    parameters.layout.description : string = "The activation flag of the shielding"

