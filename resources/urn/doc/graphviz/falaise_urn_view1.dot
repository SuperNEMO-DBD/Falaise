  };
 
  subgraph clusterUrn_Geometry_Services_5_0 {
    fontname="bold";
    label="Services";
    bgcolor="white"; 

    /**************************************************/
    Geometry_5_0_Services [ shape="plain" fontname="Courier" label = <
    <table border="1">
      <tr><td PORT="MAIN"  bgcolor="cyan"       align="left"  >urn:snemo:demonstrator:geometry:5.0:services</td></tr>
      <tr><td              bgcolor="lightgrey"  align="left"  >category: services</td></tr>
      <tr><td PORT="GEOM"                       align="right" >geometry : geomsetup</td></tr>
      <tr><td PORT="PATH"  bgcolor="lightgreen" align="right" >path</td></tr>
    </table>
    >; ];

  };

  Geometry_Variants_Service_2_0:VARREG -> Geometry_Variants_2_0:MAIN:e;
  Geometry_5_0:VARIANTS                -> Geometry_Variants_Service_2_0:MAIN:e[ color="magenta"; ];
  Geometry_5_0_Services:GEOM           -> Geometry_5_0:MAIN:e; 

};

Geometry_5_0:EXP:w -> ExperimentSuperNEMO:MAIN:e;

  };

